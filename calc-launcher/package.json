{
  "name": "calc-launcher",
  "displayName": "Calculator Launcher",
  "description": "A simple Calculator launch test",
  "version": "1.0.0",
  "publisher": "local-test",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:calc-launcher.launchCalc"
  ],
  "contributes": {
    "commands": [
      {
        "command": "calc-launcher.launchCalc",
        "title": "Launch Calculator"
      }
    ]
  }
}
